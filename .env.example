OSIRIS_ENV=development
OSIRIS_DEBUG=true
OSIRIS_SECRET_KEY=replace-with-a-long-random-secret
OSIRIS_ALLOWED_HOSTS=127.0.0.1,localhost
OSIRIS_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
OSIRIS_TIME_ZONE=America/Bogota

# En producción configure una base central propia de OSIRIS.
# Si OSIRIS_DB_NAME queda vacío, desarrollo y pruebas usan SQLite.
OSIRIS_SQLITE_PATH=osiris.sqlite3
OSIRIS_DB_NAME=
OSIRIS_DB_USER=osiris_app
OSIRIS_DB_PASSWORD=
OSIRIS_DB_HOST=127.0.0.1
OSIRIS_DB_PORT=5432
OSIRIS_DB_SSLMODE=prefer

# Ruta absoluta a un JSON protegido, fuera del repositorio en producción.
OSIRIS_CLIENT_DATABASES_FILE=/etc/osiris/client_databases.json

OSIRIS_CACHE_TIMEOUT=120
OSIRIS_DASHBOARD_CACHE_TTL=120
OSIRIS_DASHBOARD_MAX_POINTS=720
OSIRIS_LOG_LEVEL=INFO
